# Environment Configuration Example
# Copy this file to .env and configure your values

# Server Configuration
SERVER_NAME=${{ values.name }}
SERVER_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Backend API (ejemplo: dominio polizas de seguro incluido como referencia,
# renombrar segun el caso de uso real)
INSURANCE_API_BASE_URL=${{ values.backendApiUrl }}
INSURANCE_API_KEY=your-api-key-here
INSURANCE_API_TIMEOUT=30

# Database (if applicable)
DATABASE_URL=postgresql://user:password@localhost/mcp_enterprise

# Feature Flags
ENABLE_CACHING=true
CACHE_TTL=3600
